{
  "name": "chest-ai-system",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-production.ps1",
    "typecheck": "npm --prefix server run typecheck && npm --prefix frontend run build",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-system.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-system.ps1",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-environment.ps1",
    "check:model": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-model.ps1",
    "test:acceptance": "node scripts/acceptance-test.mjs",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-system.ps1",
    "check:release": "node scripts/release-preflight.mjs",
    "quickstart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/quickstart.ps1",
    "configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-system.ps1",
    "db:init": "node scripts/local-database.mjs init",
    "models:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-models.ps1",
    "test:bootstrap": "node --test scripts/local-database.test.mjs",
    "test:demo": "node --test scripts/ci-demo.mjs"
  }
}
