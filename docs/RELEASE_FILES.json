  "trees": [
    {
      "path": "frontend/src",
      "extensions": [
        ".vue",
        ".ts",
        ".css",
        ".svg",
        ".json"
      ]
    },
    {
      "path": "server/src",
      "extensions": [
        ".ts",
        ".json"
      ]
    },
    {
      "path": "server/knowledge",
      "extensions": [
        ".md"
      ]
    },
    {
      "path": "inference/model_runtime",
      "extensions": [
        ".py"
      ]
    },
    {
      "path": "inference/training",
      "extensions": [
        ".py"
      ]
    },
    {
      "path": "scripts",
      "extensions": [
        ".ps1",
        ".mjs",
        ".py"
      ]
    },
    {
      "path": ".github/workflows",
      "extensions": [
        ".yml",
        ".yaml"
      ]
    }
  ],
  "excludes": [
    "actual .env files",
    "weights and pretrained caches",
    "datasets and images",
    "uploads, exports and logs",
    "node_modules and Python environments",
    "dist and runtime process files",
    "historical planning and task-allocation documents"
  ]
}
